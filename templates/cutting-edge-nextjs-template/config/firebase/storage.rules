rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /uploads {
      allow list: if true;
      allow read, write: if false;
    }

    match /uploads/avatars {
      allow list: if true;
      allow read, write: if false;
    }

    match /uploads/avatars/{userId} {
      allow list: if true;
      allow read, write: if false;
    }

    match /uploads/avatars/{userId}/{allPaths=**} {
      allow list, get: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
